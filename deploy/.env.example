# ================= Habit Check-in — deployment config =================
# Copy thành deploy/.env rồi điền giá trị thật:  cp .env.example .env

# --- PostgreSQL ---
DB_PASSWORD=change-me-strong-password

# --- Google OAuth (https://console.cloud.google.com/apis/credentials) ---
# Thêm URI redirect:
#   dev:  http://localhost:5173
#   prod: https://<domain-cua-ban>
GOOGLE_CLIENT_ID=xxxxxx.apps.googleusercontent.com

# --- JWT nội bộ (chuỗi >= 32 ký tự, vd: openssl rand -hex 32) ---
JWT_SECRET=change-me-64-char-secret

# --- Cloudinary (https://cloudinary.com/console) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Upload preset SIGNED tạo trong Cloudinary console:
#   Proof:  folder "habit", ảnh resize max 1600px + q_auto,f_auto; video sinh thumbnail, giới hạn độ dài
#   Avatar: folder "avatars", c_fill,g_face,w_256,h_256,r_max
CLOUDINARY_PROOF_PRESET=habit_proof_signed
CLOUDINARY_AVATAR_PRESET=habit_avatar_signed

# --- Frontend (dùng cho CORS của API) ---
FRONTEND_URL=http://localhost:8080
